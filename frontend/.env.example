# Frontend (Next.js development data layer)
DATABASE_URL=file:./db/custom.db
NEXT_PUBLIC_API_URL=

# FastAPI service. Use SQLite locally; Docker Compose overrides this with Postgres.
BACKEND_DATABASE_URL=sqlite:///./backend/sentinel.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-unique-secret-before-deployment
AUDIT_IP_SALT=replace-with-a-long-unique-audit-salt
CORS_ORIGINS=http://localhost:3000

# Provider selection: mock needs no credentials and is the safe development default.
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
STT_PROVIDER=mock
TTS_PROVIDER=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Enable seed records only in a private development environment.
ALLOW_SEED=0
ENVIRONMENT=development
