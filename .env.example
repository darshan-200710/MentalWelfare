# ===== Frontend (Next.js) =====
DATABASE_URL=file:./db/custom.db
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
AI_PROVIDER=mental_welfare

# ===== Backend (FastAPI) =====
BACKEND_DATABASE_URL=sqlite:///./sentinel.db
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=replace-with-a-long-unique-secret-min-32-chars
CSRF_SECRET=replace-with-a-csrf-secret-min-16-chars
AUDIT_IP_SALT=replace-with-audit-salt
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# ===== ML Service =====
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT=30
ML_DEVICE=cpu  # or cuda

# ===== AI Provider (alternative to ML service) =====
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ===== Email =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@mentalwelfare.in

# ===== OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ===== MFA =====
MFA_ISSUER=MentalWelfare

# ===== Seed Data =====
ALLOW_SEED=1
